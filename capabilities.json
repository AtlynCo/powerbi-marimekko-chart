{
  "dataRoles": [
    { "name": "segment", "displayName": "Segment", "displayNameKey": "Role_Segment", "kind": "Grouping" },
    { "name": "component", "displayName": "Component", "displayNameKey": "Role_Component", "kind": "Grouping" },
    { "name": "value", "displayName": "Additive value", "displayNameKey": "Role_Value", "kind": "Measure", "requiredTypes": [{ "numeric": true }] }
  ],
  "dataViewMappings": [{
    "conditions": [{ "segment": { "min": 1, "max": 1 }, "component": { "min": 1, "max": 1 }, "value": { "min": 1, "max": 1 } }],
    "categorical": {
      "categories": { "for": { "in": "segment" }, "dataReductionAlgorithm": { "window": { "count": 100 } } },
      "values": { "group": {
        "by": "component",
        "select": [{ "bind": { "to": "value" } }],
        "dataReductionAlgorithm": { "top": { "count": 41 } }
      } }
    }
  }],
  "objects": {
    "dataContract": {
      "displayName": "Data contract",
      "properties": {
        "additiveConfirmed": { "displayName": "Value is additive, not a ratio or distinct count", "type": { "bool": true } }
      }
    },
    "appearance": {
      "displayName": "Presentation",
      "properties": {
        "showLabels": { "displayName": "Show labels", "type": { "bool": true } },
        "labelContent": { "displayName": "Label content", "type": { "enumeration": [
          { "displayName": "Within-segment share", "value": "segmentShare" },
          { "displayName": "Raw value", "value": "raw" },
          { "displayName": "Overall share", "value": "overallShare" }
        ] } },
        "minLabelWidth": { "displayName": "Minimum label width (px)", "type": { "numeric": true } },
        "fontSize": { "displayName": "Font size (px)", "type": { "numeric": true } },
        "showTable": { "displayName": "Show accessible data table", "type": { "bool": true } },
        "direction": { "displayName": "Text direction", "type": { "enumeration": [
          { "displayName": "Automatic", "value": "auto" },
          { "displayName": "Left to right", "value": "ltr" },
          { "displayName": "Right to left", "value": "rtl" }
        ] } }
      }
    }
  },
  "sorting": { "default": {} },
  "supportsHighlight": true,
  "supportsKeyboardFocus": true,
  "supportsEmptyDataView": true,
  "supportsLandingPage": true,
  "supportsMultiVisualSelection": true,
  "tooltips": { "supportedTypes": { "default": true } },
  "privileges": []
}
